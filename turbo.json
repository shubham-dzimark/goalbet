{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "src/generated/**"
      ],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_REALTIME"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "CI"
      ]
    },
    "@goalbet/web#typecheck": {
      "dependsOn": [
        "^build",
        "@goalbet/web#build"
      ]
    },
    "@goalbet/admin#typecheck": {
      "dependsOn": [
        "^build",
        "@goalbet/admin#build"
      ]
    }
  },
  "globalPassThroughEnv": [
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL"
  ]
}
