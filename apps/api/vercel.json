{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@goalbet/api && pnpm --filter @goalbet/api build:serverless && pnpm --filter @goalbet/db migrate:deploy",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/swagger-ui-dist/**"
    }
  },
  "crons": [
    {
      "path": "/cron/refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/settle",
      "schedule": "30 6 * * *"
    }
  ],
  "regions": [
    "fra1"
  ]
}
