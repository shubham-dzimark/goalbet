{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@goalbet/api && pnpm --filter @goalbet/db migrate:deploy",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/cron/refresh", "schedule": "0 6 * * *" }]
}
