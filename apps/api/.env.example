NODE_ENV=development
PORT=4000
# Local (scripts/local-services.sh): Postgres on 5434. Docker compose: postgresql://goalbet:goalbet@postgres:5432/goalbet
DATABASE_URL=postgresql://goalbet@127.0.0.1:5434/goalbet
REDIS_URL=redis://127.0.0.1:6379
# 32+ random characters each, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ADMIN_SECRET=change-me-too-change-me-too-change-me-too
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
ADMIN_IDLE_TIMEOUT_MIN=30
# mock | api-football
ODDS_PROVIDER=mock
API_FOOTBALL_KEY=
# Dev/test-only endpoints (/dev/mock/*, /dev/mailbox). Must be false in production.
MOCK_CONTROL_ENABLED=true
LOG_LEVEL=info
LOG_PRETTY=true
SENTRY_DSN=

# Bank-transfer deposits: details shown to players (replace the demo values)
PAYMENT_BANK_BENEFICIARY=GoalBet Demo SRL
PAYMENT_BANK_IBAN=RO49AAAA1B31007593840000
PAYMENT_BANK_NAME=Demo Bank
