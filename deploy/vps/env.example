# Copy to .env next to docker-compose.prod.yml on the server and fill in every value.
# Generate secrets with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=

# Public addresses of the two frontends (no trailing slash)
WEB_ORIGIN=https://betuno.eu
ADMIN_ORIGIN=https://admin.betuno.eu
# Other addresses the browser may use (comma-separated), e.g. the fallback admin on :8080
EXTRA_ORIGINS=http://YOUR-IP:8080,http://betuno.eu:8080
WEB_PORT=80
ADMIN_PORT=8080

# Cookies are Secure automatically on HTTPS requests. Once only HTTPS is used (no :8080 fallback),
# set COOKIE_SECURE=true and ALLOW_INSECURE_LOCAL=false. Plain-HTTP hosting needs these two:
COOKIE_SECURE=false
ALLOW_INSECURE_LOCAL=true

# Odds/fixtures: mock, or api-football with a key (the key's daily quota is shared by every deployment using it)
ODDS_PROVIDER=api-football
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_BUDGET=45

SENTRY_DSN=
SMTP_URL=
