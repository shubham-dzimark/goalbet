{
  "name": "goalbet",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @goalbet/e2e test",
    "db:generate": "pnpm --filter @goalbet/db generate",
    "db:migrate": "pnpm --filter @goalbet/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @goalbet/db migrate:dev",
    "db:reset": "pnpm --filter @goalbet/db migrate:reset",
    "db:seed": "pnpm --filter @goalbet/api seed",
    "services:start": "bash scripts/local-services.sh start",
    "services:stop": "bash scripts/local-services.sh stop",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
